{
  "name": "foldscape",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint ./app ./components ./lib ./tests",
    "lint:fix": "eslint ./app ./components ./lib ./tests --fix",
    "format": "prettier --write \"./app/**/*.{ts,tsx,css}\" \"./components/**/*.{ts,tsx}\" \"./lib/**/*.{ts,tsx}\" \"./tests/**/*.{ts,tsx}\" \"./*.{json,md,mjs,ts}\"",
    "format:check": "prettier --check \"./app/**/*.{ts,tsx,css}\" \"./components/**/*.{ts,tsx}\" \"./lib/**/*.{ts,tsx}\" \"./tests/**/*.{ts,tsx}\" \"./*.{json,md,mjs,ts}\"",
    "video:vo": "tsx --env-file=.env.local video/scripts/generate-vo.ts",
    "video:tts-test": "tsx --env-file=.env.local video/scripts/tts-test.ts",
    "video:studio": "remotion studio video/src/index.ts",
    "video:render": "remotion render video/src/index.ts"
  },
  "dependencies": {
    "katex": "^0.17.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-katex": "^3.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@next/eslint-plugin-next": "^15.5.19",
    "@remotion/bundler": "^4.0.473",
    "@remotion/cli": "^4.0.473",
    "@remotion/media-utils": "^4.0.473",
    "@remotion/renderer": "^4.0.473",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/katex": "^0.16.8",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.19",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^30.0.1",
    "openai": "^6.42.0",
    "postcss": "^8.4.49",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "remotion": "^4.0.473",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
